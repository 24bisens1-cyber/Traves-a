# Optional: configure only providers you are authorised to use.
# Never commit a real secret to Git.
# Global daily true-colour satellite fallback uses NASA GIBS without an API key.
# Optional: licensed MapTiler satellite tiles add higher detail; restrict the key by domain.
MAP_DEFAULT_LAYER=road
MAPTILER_API_KEY=

# Amadeus self-service Flight Offers Search API. Use the test host while validating.
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Bootstrap one admin once. Use a unique password of at least 16 characters.
# Remove/rotate credentials after initial provisioning; never commit a real value.
CITYPULSEX_ADMIN_EMAIL=
CITYPULSEX_ADMIN_PASSWORD=
# Set COOKIE_SECURE=1 behind HTTPS in production; use 0 for local HTTP development only.
COOKIE_SECURE=0


# Optional generative companion chat via an OpenAI-compatible chat-completions API.
# Without LLM_API_KEY, TRAVESÍA uses the local rule-based companion fallback.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Optional approved official weather endpoint. Configure only after provider approval.

# Optional database override; use persistent disk/database configuration in deployment.
# CITYPULSEX_DB=instance/citypulsex.sqlite3

# Optional public contact for service operators and future provider support.
CITYPULSEX_CONTACT_EMAIL=

# Required to enable MET Norway (commercial-capable CC BY 4.0 forecasts): a real public contact email or website. Do not invent it.
CITYPULSEX_CONTACT_URL=
# Non-commercial dev/demo fallback only. Set 0 on a commercial deployment unless your Open-Meteo plan permits use.
WEATHER_ALLOW_OPEN_METEO_FREE=1

# Trust one reverse proxy only when your host overwrites forwarded headers (Render sets this).
# Keep 0 for localhost/direct Docker use.
CITYPULSEX_TRUST_PROXY=0
CITYPULSEX_ENV=development
